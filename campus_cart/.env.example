# Database
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/campuscart?retryWrites=true&w=majority"

# Auth.js / NextAuth v5
# Generate secret with: npx auth secret or openssl rand -base64 32
AUTH_SECRET="your-auth-secret-key-min-32-chars"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Gemini API (AI Features)
GEMINI_API_KEY="your-gemini-api-key"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

